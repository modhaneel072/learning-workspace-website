# Sub-path the site is served from. GitHub Pages project sites use "/<repo-name>";
# leave empty when the site is at a domain root (e.g. Vercel or a custom domain).
NEXT_PUBLIC_BASE_PATH=

# Full public URL including the sub-path (canonical links, sitemap, social cards).
NEXT_PUBLIC_SITE_URL=https://example.com

# Early-access form endpoint the browser posts JSON to, e.g. a Formspree form URL
# (https://formspree.io/f/xxxxxxx). It must accept JSON and allow cross-origin
# requests. Leave empty to keep the form in its "not connected" state: nothing is
# sent or stored. On GitHub Pages, set it as the repository variable EARLY_ACCESS_ENDPOINT.
NEXT_PUBLIC_EARLY_ACCESS_ENDPOINT=
